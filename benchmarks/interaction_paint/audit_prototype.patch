diff -ruN a/frontend/src/utils/svg/vectorProxy.ts b/frontend/src/utils/svg/vectorProxy.ts
--- a/frontend/src/utils/svg/vectorProxy.ts
+++ b/frontend/src/utils/svg/vectorProxy.ts
@@ -0,0 +1,143 @@
+// AUDIT PROTOTYPE (scratch copy only) — vector proxy for pan/zoom gestures.
+//
+// Builds a LIGHT stand-in <svg> for the live NAD: every branch half-edge
+// polyline and every bus/winding circle is merged into ONE <path> per CSS
+// class group (≈ 30 elements instead of ≈ 99k nodes). The groups keep the
+// pypowsybl classes and nesting, so the NAD's own <style> (a document-level
+// sheet) and App.css colour / non-scaling-stroke rules paint the proxy exactly
+// like the live diagram. Highlight halos (#nad-background-layer) are cloned
+// as-is (a handful of nodes). Edge-info flows and VL labels are left out —
+// the gesture already culls them today.
+//
+// During a gesture usePanZoom only rewrites the PROXY's viewBox; the live SVG
+// is not touched until settle, so no 99k-node style/layout runs per frame.
+
+const NS = 'http://www.w3.org/2000/svg';
+const GRID = 8;
+
+const circlePath = (cx: number, cy: number, r: number): string =>
+    `M${cx - r} ${cy}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0`;
+
+const ensureGroup = (root: Element, cache: Map<string, Element>, outer: string, inner: string, tag = 'g'): Element => {
+    const key = `${outer}|${inner}`;
+    let g = cache.get(key);
+    if (!g) {
+        let o = cache.get(outer);
+        if (!o) {
+            o = document.createElementNS(NS, tag);
+            o.setAttribute('class', outer);
+            root.appendChild(o);
+            cache.set(outer, o);
+        }
+        g = document.createElementNS(NS, 'g');
+        if (inner) g.setAttribute('class', inner);
+        o.appendChild(g);
+        cache.set(key, g);
+    }
+    return g;
+};
+
+export interface VectorProxyStats { elements: number; mergedPaths: number; buildMs: number; segments: number }
+
+export const buildVectorProxy = (
+    live: SVGSVGElement,
+    extent?: { x: number; y: number; w: number; h: number } | null,
+): { proxy: SVGSVGElement; stats: VectorProxyStats } => {
+    const t0 = performance.now();
+    const proxy = document.createElementNS(NS, 'svg') as SVGSVGElement;
+    proxy.setAttribute('preserveAspectRatio', live.getAttribute('preserveAspectRatio') || 'xMidYMid meet');
+    proxy.setAttribute('class', 'nad-vector-proxy');
+    const groups = new Map<string, Element>();
+    const dParts = new Map<Element, Map<string, string[]>>();
+    // Spatial chunking: one merged path per (class group, grid cell) instead of
+    // one per class group. A single path spanning the whole network is
+    // re-tessellated by EVERY raster tile it touches; per-cell paths let the
+    // tile / cull-rect bounds skip what is not on that tile or off-screen.
+    // Grid over the FULL diagram extent (the live viewBox may be zoomed in).
+    const vb0 = live.viewBox?.baseVal;
+    const gx0 = extent ? extent.x : (vb0?.x ?? 0), gy0 = extent ? extent.y : (vb0?.y ?? 0);
+    const gw = (extent ? extent.w : vb0?.width) || 1, gh = (extent ? extent.h : vb0?.height) || 1;
+    const cell = (x: number, y: number): number => {
+        const cx = Math.max(0, Math.min(GRID - 1, Math.floor(((x - gx0) / gw) * GRID)));
+        const cy = Math.max(0, Math.min(GRID - 1, Math.floor(((y - gy0) / gh) * GRID)));
+        return cy * GRID + cx;
+    };
+    const push = (g: Element, cls: string, d: string, x = 0, y = 0) => {
+        let m = dParts.get(g);
+        if (!m) { m = new Map(); dParts.set(g, m); }
+        const key = `${cls}\u0000${cell(x, y)}`;
+        let arr = m.get(key);
+        if (!arr) { arr = []; m.set(key, arr); }
+        arr.push(d);
+    };
+    let segments = 0;
+
+    // Halos first (they render BEHIND the network, as in the live SVG).
+    const bg = live.querySelector('#nad-background-layer');
+    if (bg && bg.childElementCount) {
+        const c = bg.cloneNode(true) as Element;
+        c.removeAttribute('id');
+        proxy.appendChild(c);
+    }
+
+    // Outer groups in pypowsybl's paint order: bus nodes under the edges.
+    for (const outer of ['nad-vl-nodes', 'nad-branch-edges']) {
+        const o = document.createElementNS(NS, 'g');
+        o.setAttribute('class', outer);
+        proxy.appendChild(o);
+        groups.set(outer, o);
+    }
+
+    // Branch edges: <g class="nad-branch-edges"><g [class=state]><polyline class="nad-vlX nad-edge-path" points/>
+    for (const pl of Array.from(live.querySelectorAll('.nad-branch-edges polyline'))) {
+        const parent = pl.parentElement;
+        const pts = (pl.getAttribute('points') || '').trim();
+        if (!pts) continue;
+        const list = pts.split(/[\s]+/);
+        segments += list.length - 1;
+        const g = ensureGroup(proxy, groups, 'nad-branch-edges', parent?.getAttribute('class') || '');
+        const [fx, fy] = list[0].split(',').map(Number);
+        push(g, pl.getAttribute('class') || '', 'M' + list.join('L'), fx, fy);
+    }
+    // Transformer windings drawn as circles inside branch edges.
+    for (const c of Array.from(live.querySelectorAll('.nad-branch-edges circle'))) {
+        const parent = c.parentElement;
+        const cc = c as SVGCircleElement;
+        const g = ensureGroup(proxy, groups, 'nad-branch-edges', parent?.getAttribute('class') || '');
+        push(g, c.getAttribute('class') || '', circlePath(cc.cx.baseVal.value, cc.cy.baseVal.value, cc.r.baseVal.value), cc.cx.baseVal.value, cc.cy.baseVal.value);
+    }
+    // Bus nodes: <g class="nad-vl-nodes"><g class="nad-vlX" transform="translate scale"><circle class="nad-bus-k nad-busnode" r/>
+    for (const node of Array.from(live.querySelectorAll('.nad-vl-nodes > g'))) {
+        const ng = node as SVGGElement;
+        const m = ng.transform?.baseVal?.consolidate()?.matrix;
+        const a = m ? m.a : 1, e = m ? m.e : 0, f = m ? m.f : 0;
+        for (const ch of Array.from(node.children)) {
+            if (ch.tagName === 'circle') {
+                const cc = ch as SVGCircleElement;
+                const g = ensureGroup(proxy, groups, 'nad-vl-nodes', node.getAttribute('class') || '');
+                const ccx = e + a * cc.cx.baseVal.value, ccy = f + a * cc.cy.baseVal.value;
+                push(g, ch.getAttribute('class') || '', circlePath(ccx, ccy, a * cc.r.baseVal.value), ccx, ccy);
+            } else {
+                // Multi-bus rings etc.: keep them as transformed clones (rare).
+                const g = ensureGroup(proxy, groups, 'nad-vl-nodes', node.getAttribute('class') || '');
+                const wrap = document.createElementNS(NS, 'g');
+                const tr = node.getAttribute('transform');
+                if (tr) wrap.setAttribute('transform', tr);
+                wrap.appendChild(ch.cloneNode(true));
+                g.appendChild(wrap);
+            }
+        }
+    }
+    let elements = 0;
+    for (const [g, m] of dParts) {
+        for (const [key, parts] of m) {
+            const cls = key.split('\u0000')[0];
+            const p = document.createElementNS(NS, 'path');
+            if (cls) p.setAttribute('class', cls);
+            p.setAttribute('d', parts.join(''));
+            g.appendChild(p);
+            elements++;
+        }
+    }
+    return { proxy, stats: { elements: proxy.querySelectorAll('*').length, mergedPaths: elements, buildMs: performance.now() - t0, segments } };
+};
