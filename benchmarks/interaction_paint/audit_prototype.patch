+    }
+    // Transformer windings (stroked circles in branch edges).
+    for (const c of Array.from(live.querySelectorAll('.nad-branch-edges circle'))) {
+        const cc = c as SVGCircleElement;
+        const key = 'wind|' + (c.parentElement?.getAttribute('class') || '') + '|' + (c.getAttribute('class') || '');
+        const st = styleFor(c, key, 'stroke');
+        if (!st.visible) continue;
+        const x = cc.cx.baseVal.value, y = cc.cy.baseVal.value, r = cc.r.baseVal.value;
+        add(key, st, (p) => { p.moveTo(x + r, y); p.arc(x, y, r, 0, Math.PI * 2); }, x - r, y - r, x + r, y + r);
+    }
+    // Bus nodes: filled circles under the VL node's translate/scale.
+    for (const node of Array.from(live.querySelectorAll('.nad-vl-nodes > g'))) {
+        const m = (node as SVGGElement).transform?.baseVal?.consolidate()?.matrix;
+        const a = m ? m.a : 1, e = m ? m.e : 0, f = m ? m.f : 0;
+        for (const ch of Array.from(node.querySelectorAll('circle'))) {
+            const cc = ch as SVGCircleElement;
+            const key = 'bus|' + (node.getAttribute('class') || '') + '|' + (ch.getAttribute('class') || '');
+            const st = styleFor(ch, key, 'fill');
+            if (!st.visible) continue;
+            const x = e + a * cc.cx.baseVal.value, y = f + a * cc.cy.baseVal.value, r = a * cc.r.baseVal.value;
+            add(key, st, (p) => { p.moveTo(x + r, y); p.arc(x, y, r, 0, Math.PI * 2); }, x - r, y - r, x + r, y + r);
+        }
+    }
+
+    // pypowsybl's paint order: halos (behind), bus nodes, then branch edges
+    // and windings on top.
+    const order = (k: string) => (k.startsWith('halo|') ? 0 : k.startsWith('bus|') ? 1 : 2);
+    const items: DrawItem[] = [...acc.entries()].sort((a, b) => order(a[0]) - order(b[0])).map(([, v]) => v);
+
+    const canvas = document.createElement('canvas');
+    canvas.className = 'nad-canvas-proxy';
+    const ctx = canvas.getContext('2d', { alpha: false, desynchronized: false });
