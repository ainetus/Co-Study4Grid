+            const b = it.bbox;
+            if (b[2] < ux0 || b[0] > ux1 || b[3] < uy0 || b[1] > uy1) continue;
+            if (it.kind === 'fill') {
+                c.fillStyle = it.color;
+                c.fill(it.path);
+            } else {
+                c.strokeStyle = it.color;
+                c.lineWidth = ((it.widthPx || 1) * widthMul) / a;
+                c.setLineDash(it.dash.length ? it.dash.map(d => (d * widthMul) / a) : []);
+                c.stroke(it.path);
+            }
+        }
+    };
+    const ensureCache = (W: number, H: number, dpr: number) => {
+        if (cache) return;
+        const CW = Math.min(4096, Math.round(2 * W * dpr)), CH = Math.min(4096, Math.round(2 * H * dpr));
+        const c = document.createElement('canvas');
+        c.width = CW; c.height = CH;
+        const cc = c.getContext('2d', { alpha: false });
+        if (!cc) return;
+        cacheScale = Math.min(CW / ext.w, CH / ext.h);
+        cacheOx = (CW - cacheScale * ext.w) / 2 - cacheScale * ext.x;
+        cacheOy = (CH - cacheScale * ext.h) / 2 - cacheScale * ext.y;
+        cc.fillStyle = bg;
+        cc.fillRect(0, 0, CW, CH);
+        // Stroke widths are exact at full extent, where the cache is shown at 1/2.
+        renderItems(cc, cacheScale, cacheOx, cacheOy, 1, -Infinity, -Infinity, Infinity, Infinity, 2);
+        cache = c;
+    };
+
+    const draw = (vb: VB) => {
+        if (!ctx) return;
+        const dpr = (container.ownerDocument.defaultView || window).devicePixelRatio || 1;
+        const W = container.clientWidth, H = container.clientHeight;
+        if (canvas.width !== Math.round(W * dpr) || canvas.height !== Math.round(H * dpr)) {
+            canvas.width = Math.round(W * dpr);
+            canvas.height = Math.round(H * dpr);
+            canvas.style.width = `${W}px`;
+            canvas.style.height = `${H}px`;
+        }
+        // Exposed for the audit harness (detects canvas frames as visual updates).
+        canvas.dataset.vb = `${vb.x} ${vb.y} ${vb.w} ${vb.h}`;
