+// AUDIT PROTOTYPE (scratch copy only) — canvas proxy for pan/zoom gestures.
+//
+// Same idea as vectorProxy.ts (draw a light stand-in of the NAD during the
+// gesture, bake the live SVG once on settle) but drawn with Canvas 2D from
+// prebuilt Path2D objects. A canvas redraw invalidates only the canvas'
+// own compositor layer: Blink does not repaint or re-layerize the document,
+// so the per-frame cost no longer depends on the ~20k paint chunks of the
+// live SVG that stays mounted underneath (PaintArtifactCompositor::Update
+// was ~67 ms/frame with the SVG proxy at region zoom).
+//
+// Colours / widths are resolved ONCE at build time from the live diagram's
+// computed styles (so pypowsybl's palette, App.css overrides and the theme
+// are honoured), then the gesture frames are pure Path2D strokes / fills
+// under a transform; non-scaling stroke is emulated by lineWidth / scale.
+
+type VB = { x: number; y: number; w: number; h: number };
+
+interface DrawItem {
+    path: Path2D;
+    kind: 'stroke' | 'fill';
+    color: string;
+    widthPx: number;       // stroke width in screen px (non-scaling)
+    dash: number[];        // screen px
+    bbox: [number, number, number, number]; // user space minX, minY, maxX, maxY
+}
+
+export interface CanvasProxy {
+    canvas: HTMLCanvasElement;
+    draw: (vb: VB) => void;
+    stats: { items: number; buildMs: number };
+}
+
+const GRID = 8;
+
+const parseDash = (v: string): number[] =>
+    !v || v === 'none' ? [] : v.split(/[\s,]+/).map(s => parseFloat(s)).filter(n => Number.isFinite(n) && n > 0);
+
+export const buildCanvasProxy = (live: SVGSVGElement, container: HTMLElement, extent: VB | null, useCache = false): CanvasProxy => {
+    const t0 = performance.now();
+    const vb0 = live.viewBox?.baseVal;
+    const ext: VB = extent ?? { x: vb0?.x ?? 0, y: vb0?.y ?? 0, w: vb0?.width || 1, h: vb0?.height || 1 };
+    const cellOf = (x: number, y: number) => {
+        const cx = Math.max(0, Math.min(GRID - 1, Math.floor(((x - ext.x) / ext.w) * GRID)));
+        const cy = Math.max(0, Math.min(GRID - 1, Math.floor(((y - ext.y) / ext.h) * GRID)));
+        return cy * GRID + cx;
+    };
+
+    // Group key → accumulated geometry for that style + grid cell.
+    type Acc = { path: Path2D; kind: 'stroke' | 'fill'; color: string; widthPx: number; dash: number[]; bbox: [number, number, number, number] };
+    const acc = new Map<string, Acc>();
+    const styleCache = new Map<string, { color: string; widthPx: number; dash: number[]; kind: 'stroke' | 'fill'; visible: boolean }>();
+    const styleFor = (el: Element, key: string, kind: 'stroke' | 'fill') => {
+        let st = styleCache.get(key);
+        if (!st) {
+            const cs = getComputedStyle(el);
+            const visible = cs.display !== 'none' && cs.visibility !== 'hidden';
+            st = kind === 'stroke'
+                ? { kind, visible: visible && cs.stroke !== 'none', color: cs.stroke, widthPx: parseFloat(cs.strokeWidth) || 1, dash: parseDash(cs.strokeDasharray) }
+                : { kind, visible: visible && cs.fill !== 'none', color: cs.fill, widthPx: 0, dash: [] };
+            styleCache.set(key, st);
+        }
+        return st;
+    };
+    const add = (key: string, st: { color: string; widthPx: number; dash: number[]; kind: 'stroke' | 'fill' }, build: (p: Path2D) => void, x0: number, y0: number, x1: number, y1: number) => {
+        const k = `${key}\u0000${cellOf((x0 + x1) / 2, (y0 + y1) / 2)}`;
+        let a = acc.get(k);
+        if (!a) { a = { path: new Path2D(), kind: st.kind, color: st.color, widthPx: st.widthPx, dash: st.dash, bbox: [Infinity, Infinity, -Infinity, -Infinity] }; acc.set(k, a); }
+        build(a.path);
+        if (x0 < a.bbox[0]) a.bbox[0] = x0;
+        if (y0 < a.bbox[1]) a.bbox[1] = y0;
+        if (x1 > a.bbox[2]) a.bbox[2] = x1;
+        if (y1 > a.bbox[3]) a.bbox[3] = y1;
+    };
+
+    // Halo clones (N-1 / Action highlights): polylines under a matrix transform.
+    for (const clone of Array.from(live.querySelectorAll('#nad-background-layer > *'))) {
+        const m = (clone as SVGGraphicsElement).transform?.baseVal?.consolidate()?.matrix;
+        for (const pl of Array.from(clone.querySelectorAll('polyline'))) {
+            const st = styleFor(pl, 'halo|' + (clone.getAttribute('class') || ''), 'stroke');
+            if (!st.visible) continue;
+            const pts = (pl.getAttribute('points') || '').trim().split(/\s+/).map(p => p.split(',').map(Number));
+            const tp = pts.map(([x, y]) => m ? [m.a * x + m.c * y + m.e, m.b * x + m.d * y + m.f] : [x, y]);
+            const xs = tp.map(p => p[0]), ys = tp.map(p => p[1]);
