+    };
+    if (useCache) {
+        const dpr0 = (container.ownerDocument.defaultView || window).devicePixelRatio || 1;
+        ensureCache(container.clientWidth, container.clientHeight, dpr0);
+    }
+    return { canvas, draw, stats: { items: items.length, buildMs: performance.now() - t0 } };
+};
